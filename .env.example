# Generate a long random secret (at least 32 random bytes) and store it only in your host's secret manager.
JARVIS_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Private MacroDroid webhook for the macro that launches WhatsApp. Never put this URL in the GPT schema.
MACRODROID_OPEN_WHATSAPP_URL=
REQUEST_TIMEOUT_SECONDS=8
JARVIS_IDEMPOTENCY_DB=/data/jarvis.sqlite3
